# ===========================
# Gemini API Configuration
# ===========================
# Any number of keys: every GOOGLE_API_KEY* entry joins the
# rotation pool and is used as a failover when one runs out of
# quota. The suffix is just a label shown in the logs.
GOOGLE_API_KEYdg=
GOOGLE_API_KEYanu=
GOOGLE_API_KEYpvt=

# ===========================
# Gemini Models
# ===========================
LLM_MODEL=
# Runs locally via fastembed - no API quota, ~15ms per query.
EMBEDDING_MODEL=

# ===========================
# FAISS Configuration
# ===========================
VECTOR_DB_PATH=

# ===========================
# Knowledge Base
# ===========================
DATA_PATH=

# ===========================
# FastAPI
# ===========================
HOST=
PORT=

# ===========================
# Retrieval
# ===========================
# Retrieval tuning (top-k, candidate pool, fusion weight) lives in
# app/utils/constants.py. TOP_K used to be set here, but it was read
# by the LLM as its sampling top_k - see LLM_TOP_K below.

# ===========================
# LLM
# ===========================
TEMPERATURE=
MAX_OUTPUT_TOKENS=
LLM_TOP_K=

# Gemini 3.x thinks by default and bills those thoughts against
# MAX_OUTPUT_TOKENS, truncating the visible answer. RAG answers are
# grounded in retrieved context, so thinking is off.
THINKING_BUDGET=
